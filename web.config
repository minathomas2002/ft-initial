<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Frame-Options" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />

        <remove name="Content-Security-Policy" />
        <add
          name="Content-Security-Policy"
          value="default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self'; script-src-elem 'self'; script-src-attr 'none'; style-src 'self' 'sha256-KsY9h4XeMYhhxWgXgBQREqpzeRRaH7AW27b2nOer2Qk='; style-src-elem 'self' 'sha256-KsY9h4XeMYhhxWgXgBQREqpzeRRaH7AW27b2nOer2Qk='; style-src-attr 'self' 'unsafe-hashes' 'sha256-KsY9h4XeMYhhxWgXgBQREqpzeRRaH7AW27b2nOer2Qk='; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https: wss:; manifest-src 'self'; worker-src 'self' blob:; media-src 'self' blob:; frame-src 'self';" />
      </customHeaders>
    </httpProtocol>

    <!-- Ensure all requests go through index.html -->
    <rewrite>
      <rules>
        <rule name="AngularRoutes" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <!-- If the request is not a file -->
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <!-- And not a folder -->
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

    <!-- Optional: serve SPA with no directory browsing -->
    <directoryBrowse enabled="false" />

    <!-- Enable static compression -->
    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
    </staticContent>

  </system.webServer>
</configuration>
